# =============================================================================
# Business Manager — environment template
#
# Copy to .env.local for local development:   cp .env.example .env.local
# NEVER commit a filled-in .env file. Only this template is version-controlled.
#
# Every variable is documented in docs/ENVIRONMENT.md, including where each
# value is obtained. All placeholder values below are fake.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — required for authentication and for the database
# Project URL and keys: Supabase dashboard -> Settings -> API Keys
# -----------------------------------------------------------------------------

# Public project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable (public) key. Safe to expose to the browser.
# Every application table has RLS enabled with no permissive policies, so this
# key cannot read business data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Secret key. SERVER ONLY — bypasses Row Level Security entirely.
# Used for administrative operations such as provisioning a user's auth
# identity. Never prefix this with NEXT_PUBLIC_ and never log it.
SUPABASE_SECRET_KEY="sb_secret_replace_me"

# Optional. Only used by the RLS verification script, to prove that the public
# API role reads nothing. The application itself uses the publishable key.
SUPABASE_ANON_KEY=""

# -----------------------------------------------------------------------------
# Database — required
# Connection strings: Supabase dashboard -> Connect
#
# These two are NOT interchangeable:
#   DATABASE_URL  the running application. Use the TRANSACTION POOLER in
#                 serverless deployments (port 6543).
#   DIRECT_URL    migrations and seeding. Must be a DIRECT or SESSION pooler
#                 connection (port 5432) — Prisma Migrate needs a real session.
# For a plain local Postgres, both can be the same value.
#
# WARNING: the direct host (db.<ref>.supabase.co) is IPv6-ONLY unless the
# project has the IPv4 add-on. On an IPv4-only network it fails with
# "Can't reach database server". Use the pooler hostname
# (aws-<n>-<region>.pooler.supabase.com, user postgres.<ref>) for BOTH URLs.
#
# Passwords must be percent-encoded in a connection URL: ^ -> %5E, * -> %2A,
# @ -> %40, : -> %3A, / -> %2F.
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Canonical URL, used for auth redirects and links in outbound messages.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# First administrator (optional, used by `pnpm db:seed`)
#
# When set — together with SUPABASE_SECRET_KEY — the seed creates a Supabase
# Auth identity and links it to a Super Admin application user. When absent the
# seed still loads roles and permissions and tells you it skipped this step.
# Use a strong password and change it after the first sign-in.
# -----------------------------------------------------------------------------

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"

# -----------------------------------------------------------------------------
# End-to-end tests (optional)
# Point at an already-running instance instead of letting Playwright start one.
# -----------------------------------------------------------------------------

# E2E_BASE_URL="http://localhost:3000"

# A 32-byte key, base64-encoded (openssl rand -base64 32). Encrypts the one
# genuinely sensitive value stored today: a Fiverr account's PayPal password
# (src/lib/crypto/secret-box.ts). Required before saving one; missing/wrong
# length fails the save rather than ever storing a secret in plain text.
# CREDENTIALS_ENCRYPTION_KEY=""

# The authenticated E2E suite signs in with these (falls back to SEED_ADMIN_*).
# E2E_ADMIN_EMAIL=""
# E2E_ADMIN_PASSWORD=""

# A SECOND, non-admin user for the write-path tests — a user may not modify
# their own access, so those tests need someone else to act on. Create with:
#   pnpm db:create-user --email worker@example.com --name "Worker" --role worker
# E2E_WORKER_EMAIL=""

# Data-boundary tests (tests/e2e/worker-boundaries.spec.ts) sign in as a THROWAWAY Worker-role user that a
# script creates and deletes, so no standing low-privilege account with a known password exists:
#   npx tsx scripts/e2e-worker-fixture.ts create /tmp/fx.json
#   E2E_WORKER_FIXTURE=/tmp/fx.json pnpm test:e2e tests/e2e/worker-boundaries.spec.ts
#   npx tsx scripts/e2e-worker-fixture.ts delete /tmp/fx.json
# E2E_WORKER_FIXTURE=""

# =============================================================================
# NOT YET USED — these arrive with their phases. Listed so the full surface is
# visible, and documented in docs/ENVIRONMENT.md. Leave unset until then; the
# application treats a missing value as "integration not configured" and fails
# closed rather than pretending a message was sent.
#
#   Phase 8 — Communication
#     RESEND_API_KEY, EMAIL_FROM
#     WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
#     WHATSAPP_BUSINESS_ACCOUNT_ID, WHATSAPP_WEBHOOK_VERIFY_TOKEN, WHATSAPP_APP_SECRET
#     REDIS_URL  (a rediss:// TCP URL — Upstash's REST URL/token are not used by BullMQ)
#
#
# =============================================================================
