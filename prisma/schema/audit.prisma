// ---------------------------------------------------------------------------
// Audit trail
//
// Append-only history of who changed what. Distinct from `order_activity`
// (Phase 4), which is the human-readable operational feed shown on an order.
// Audit rows are written by services inside the same transaction as the change
// they describe.
// ---------------------------------------------------------------------------

/// Immutable record of a state change.
///
/// Never updated and never deleted by application code. There is no update or
/// delete path exposed in any service — specification Section 64 requires audit
/// history not be casually editable.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Actor may be null for system-initiated actions (seeds, scheduled jobs).
  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Snapshot of the actor's email at the time of the action. Denormalised on
  /// purpose so the log stays readable even if the profile is later renamed.
  actorEmail String? @map("actor_email") @db.VarChar(320)

  /// Machine-readable action, e.g. `user.role.assigned`, `role.permission.revoked`.
  action String @db.VarChar(120)

  /// Target entity, e.g. `User`, `Role`, `Order`.
  entityType String  @map("entity_type") @db.VarChar(60)
  entityId   String? @map("entity_id") @db.VarChar(64)

  /// One-line human summary, e.g. "Assigned role Operations Manager to Ahmed Khan".
  summary String @db.Text

  /// Field-level before/after. Stored as JSON because the shape differs per
  /// entity. Services must redact secrets before writing here.
  previousValue Json? @map("previous_value")
  newValue      Json? @map("new_value")

  ipAddress String? @map("ip_address") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Supports the entity history panel (most recent first).
  @@index([entityType, entityId, createdAt(sort: Desc)])
  /// Supports "what did this person do" on a user profile.
  @@index([actorUserId, createdAt(sort: Desc)])
  /// Supports the global activity feed.
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
