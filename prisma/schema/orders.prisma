// ---------------------------------------------------------------------------
// Orders (Phase 4) — specification Sections 21–28, 39–42, 62, 64, 133–134
//
// What is here:
//   - OutsourcedWorker: a third-party worker with no application account — a
//     cost-tracking contact, not an actor in the system. See the Order Item
//     "worker" note below.
//   - Order: the commercial container (§22). `orderNumber` is a plain
//     autoincrement integer — the specification asks for an internal
//     id/number, not a formatted scheme, so the simplest reliable option wins.
//   - OrderItem: the unit of work (§24), independent status from its parent
//     (§41). `workerCost` is a SNAPSHOT taken when the item is created or
//     edited — never recomputed later from a worker's current rate, so a
//     later change never rewrites what an existing order recorded as paid.
//     Confirmed directly by the owner (docs/REQUIREMENTS.md D3 note).
//     Owner-directed redesign (confirmed directly, 2026-09-27, D12): an item
//     has NO price of its own any more — `Order.totalAmount` is the single,
//     directly-entered price for the whole order. An item whose Service is
//     tagged with a `ServiceMetricType` (catalog.prisma) additionally carries
//     `channelLink`/`targetCount`/`currentCount` — the structured shape of
//     "if subscribers it would take the channel link, number of subscribers
//     required, current subscribers, and a note" (the existing `description`
//     field is that note).
//   - OrderItemLink: normalized URLs for search (§25, §27, §133, §134) —
//     a table, not a text field.
//   - OrderNote: internal notes, distinct from activity (§62).
//   - OrderActivity: the operational feed on an order — distinct from
//     `audit_logs` (the security record) and from notes. Three different
//     things (§64, docs/ORDERS.md §9).
//   - NotificationOutbox: durable notification INTENT written inside Process
//     Order's transaction, addition to the §21 entity list justified in
//     docs/ARCHITECTURE.md §8 — no dispatcher drains it until Phase 8, but
//     Process Order must not fail because a message provider is unreachable.
//
// Full design reasoning, the state-machine transition tables, and the search
// architecture are recorded in docs/ORDERS.md and docs/ARCHITECTURE.md §5–6 —
// written before this file, per specification Section 159.
//
// What is deliberately NOT here: order files (§63). Supabase Storage needs a
// bucket configured first — no bucket exists in this project yet, the same
// "missing configuration must not stop independent work, but cannot be
// silently assumed" reasoning as Phase 1's messaging providers.
// ---------------------------------------------------------------------------

/// Owner-directed simplification (confirmed directly, 2026-09-27: "currently
/// there are only two sources for order Fiverr and External"), replacing the
/// original generic four-value enum (DIRECT/WHOLESALE/MANUAL/OTHER). Existing
/// rows were backfilled by whether they already had a `fiverrAccountId`.
enum OrderSource {
  FIVERR
  EXTERNAL
}

/// Order statuses (owner-directed rework, 2026-11-03). The first five are
/// CALCULATED from the order's items and never set by hand
/// (`deriveOrderStatus`, src/lib/orders/state-machine.ts):
///   PENDING              not every item has a worker yet
///   ASSIGNED             every item has a worker, not all have accepted
///   PROCESSING           every item accepted, none done yet
///   PARTIALLY_COMPLETED  some items done, the rest still being worked on
///   COMPLETED            every item done
/// The last three are set by an admin: DELIVERED (revenue is recognized
/// here, `deliveredAt`), FINALIZED, and CANCELLED (shown as
/// "Refunded / Cancelled"; excluded from revenue).
enum OrderStatus {
  PENDING
  ASSIGNED
  PROCESSING
  PARTIALLY_COMPLETED
  COMPLETED
  DELIVERED
  FINALIZED
  CANCELLED
}

/// Item statuses (owner-directed rework, 2026-11-03): PENDING (no worker, or
/// assigned and not yet accepted) → PROCESSING (the worker accepted) → DONE
/// (the worker finished; counts as complete straight away) → REFILL (an
/// admin reopened a done item, e.g. delivered subscribers dropped; the worker
/// marks it done again). CANCELLED is an admin action.
enum OrderItemStatus {
  PENDING
  PROCESSING
  DONE
  REFILL
  CANCELLED
}

/// A third-party worker with no application account, no login, no RBAC —
/// just a name and a cost to track per Order Item. NOT a `User`: modelling an
/// outsourced worker as one would require an email and an auth identity for
/// someone who is a cost-tracking record, not an actor in the system.
/// How an External Worker hears about a new task (2026-11-11). Email is sent
/// by the app; WhatsApp is a prefilled message an admin sends with one tap.
enum WorkerNotifyChannel {
  NONE
  EMAIL
  WHATSAPP
  BOTH
}

model OutsourcedWorker {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @db.VarChar(160)
  email          String? @db.VarChar(320)
  phone          String? @db.VarChar(32)
  whatsappNumber String? @map("whatsapp_number") @db.VarChar(32)
  notes          String? @db.Text

  /// Where a new task is sent when it's assigned (owner request, 2026-11-11).
  /// A channel without an email/number on file is skipped.
  notifyVia WorkerNotifyChannel @default(BOTH) @map("notify_via")

  /// Set once this External Worker is onboarded with portal access — owner-
  /// directed, confirmed directly (2026-10-08): "External or outsourced
  /// workers should be able to login and have there own dashboard." Null
  /// otherwise; this record remains usable as a pure cost-tracking contact
  /// with no login, the original design. Linking reuses the existing
  /// Supabase Auth + `User`/`Role`/permission machinery (the seeded
  /// "External Worker" role, see `prisma/seed.ts`) rather than a second,
  /// bespoke auth system — the SAME login page and session handling as an
  /// Employee, just a far narrower permission grant. Kept SEPARATE from
  /// `User` as a record (not merged into it) per "keep the External
  /// Workers separate from employees" — this FK is the only bridge between
  /// the two.
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// A worker no longer used is deactivated, not deleted, so past order items
  /// that reference them keep resolving.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems OrderItem[]
  payments   WorkerPayment[]
  rates      ServiceRate[]

  @@index([isActive])
  @@index([name])
  // Trigram indexes for ILIKE '%q%' search (global search, docs/DATABASE.md). Declared here — with ops: raw("gin_trgm_ops") —
  // so `migrate dev` no longer proposes dropping them.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "outsourced_workers_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "outsourced_workers_phone_trgm_idx")
  @@map("outsourced_workers")
}

/// The commercial container (specification Section 22).
model Order {
  id String @id @default(uuid()) @db.Uuid

  /// Plain autoincrement integer — the specification asks for an internal
  /// id/number, not a formatted scheme. Displayed as "#1042".
  orderNumber Int @unique @default(autoincrement()) @map("order_number")

  source OrderSource @default(EXTERNAL)

  /// A Fiverr order's Fiverr order id, if wanted, recorded here as plain text
  /// — never a live Fiverr integration of any kind (no API, auth, sync,
  /// scraping or webhooks — the Absolute Fiverr Rule, specification Section
  /// 2, still holds). `source` itself naming "Fiverr" is a deliberate,
  /// owner-directed exception to Section 22's "do not make them
  /// Fiverr-specific" for the source field only — see the enum's doc comment.
  externalReference String? @map("external_reference") @db.VarChar(160)

  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Which of the business's Fiverr seller profiles this order landed on.
  /// Required by the service layer when `source = FIVERR`; never asked for,
  /// and forced to null, when `source = EXTERNAL` (confirmed directly,
  /// 2026-09-27: "fiverr account should be taken if source is Fiverr").
  fiverrAccountId String?        @map("fiverr_account_id") @db.Uuid
  fiverrAccount   FiverrAccount? @relation(fields: [fiverrAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  orderDate DateTime  @default(now()) @map("order_date") @db.Timestamptz(6)
  deadline  DateTime? @db.Timestamptz(6)

  status OrderStatus @default(PENDING)

  /// The whole order's price, entered directly by whoever creates or edits
  /// the order (owner-directed redesign, confirmed directly 2026-09-27: "order
  /// price should be taken for the whole order not for each item") — NOT
  /// derived from its items, which carry no price of their own any more. See
  /// the file header and docs/REQUIREMENTS.md D12.
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// See docs/REQUIREMENTS.md D1: amounts in different currencies must never
  /// be summed into one total.
  currency    String  @default("USD") @db.Char(3)

  notes String? @db.Text

  /// Set when the order transitions to DELIVERED — revenue recognition point
  /// (docs/REQUIREMENTS.md D4, answered 2026-09-17), and needed for
  /// period-based revenue reporting since `orderDate` is the creation date,
  /// not when it was actually delivered.
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  /// Whole-order, boolean, no partial refund (D4 follow-up, answered
  /// 2026-09-17) — a refunded order keeps its real status (Delivered/
  /// Completed); this just excludes it from recognized revenue. Who/when is
  /// covered by the audit log on the edit, not a duplicate field here.
  refunded Boolean @default(false)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items         OrderItem[]
  internalNotes OrderNote[]
  expenses      Expense[]
  activity      OrderActivity[]

  @@index([status])
  @@index([deadline])
  @@index([customerId])
  @@index([createdAt])
  @@index([source])
  @@index([fiverrAccountId])
  // Trigram indexes for ILIKE '%q%' search (global search, docs/DATABASE.md). Declared here — with ops: raw("gin_trgm_ops") —
  // so `migrate dev` no longer proposes dropping them.
  @@index([externalReference(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_external_reference_trgm_idx")
  @@map("orders")
}

/// The unit of work (specification Section 24). Status is independent of the
/// parent Order (Section 41) — nothing here is bulk-written by a parent
/// status change.
model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Snapshotted from `service.categoryId` at creation, so a later
  /// re-categorisation of the service does not rewrite what this item was
  /// filed under at the time.
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// DEPRECATED, 2026-10-08 — kept only so pre-rework rows that really were
  /// assigned to an internal user keep resolving; never set by any
  /// assignment path going forward. Owner-directed, confirmed directly:
  /// "employees wont be assigned a order item its assigned to
  /// oursourced(external) only." Previously: exactly one of `workerId` /
  /// `outsourcedWorkerId` was set, enforced in the service layer (a `CHECK`
  /// spanning two nullable FKs adds little and Postgres has no portable
  /// "exactly one of" constraint short of a trigger) — see the
  /// OutsourcedWorker doc comment for why these were two different
  /// relations rather than one polymorphic one. Now `outsourcedWorkerId`
  /// is the only live assignment path.
  workerId String? @map("worker_id") @db.Uuid
  worker   User?   @relation("OrderItemWorker", fields: [workerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  outsourcedWorkerId String?           @map("outsourced_worker_id") @db.Uuid
  outsourcedWorker   OutsourcedWorker? @relation(fields: [outsourcedWorkerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// The Employee who performed the assignment — owner-directed, confirmed
  /// directly (2026-10-08): "put key assigned_by in order_item." Distinct
  /// from `workerId`/`outsourcedWorkerId` above (who does the work): an
  /// Employee is never themselves the assignee (see the file header) —
  /// this just records which manager assigned this item, for
  /// accountability. Set whenever an assignment is made; never cleared by
  /// a later re-assignment (history of who made the LAST assignment, not
  /// a running log — `OrderActivity` already covers the full history).
  assignedById String? @map("assigned_by") @db.Uuid
  assignedBy   User?   @relation("OrderItemAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Doubles as the free-text "note" the owner described alongside the
  /// structured metric fields below.
  description String?   @db.Text
  /// The assigned worker's deadline (2026-11-03, owner request). Normally
  /// derived: the order's deadline minus the gap configured in Settings
  /// (src/lib/settings/worker-deadline.ts), rewritten whenever the order's
  /// deadline or those settings change. Stored rather than computed on read so
  /// every list, count and filter can use it directly.
  deadline    DateTime? @db.Timestamptz(6)
  /// True once someone sets this item's deadline by hand: it then stops
  /// following the order deadline and the settings until reset to automatic.
  deadlineOverridden Boolean @default(false) @map("deadline_overridden")

  /// The client's channel, only meaningful when `service.metricType` is set
  /// — see the file header. Plain text, validated http(s)-only at the
  /// service layer (never fetched by the server, same rule as
  /// `OrderItemLink.url`) and rendered as a link the same safe way.
  channelLink   String? @map("channel_link") @db.Text
  /// How many of the metric are wanted (e.g. "1000 subscribers"). Required by
  /// the service layer whenever `service.metricType` is set.
  targetCount   Int?    @map("target_count")
  /// Where the channel stands right now for this metric. Optional — not
  /// always known at creation, and tracked/updated as the item progresses.
  currentCount  Int?    @map("current_count")
  /// A snapshot of `currentCount` taken ONLY at creation — never touched by
  /// an edit or a progress update afterward. Owner-directed, confirmed
  /// directly (2026-10-05): "the progress on orders page should not consider
  /// the count of item at the time of the order it should show the actual
  /// work progress" — i.e. 1000 starting + 5000 required = 6000 target, and
  /// sitting at 1000 (no work done yet) must read as 0%, not as
  /// 1000/6000 (~17%). `targetCount - startingCount` recovers "how many
  /// more were asked for"; `currentCount - startingCount` recovers "how
  /// many have actually been delivered since" — see
  /// `src/lib/orders/progress.ts`. Null for items created before this
  /// column existed; `aggregateProgress` treats a null baseline as 0 (the
  /// pre-existing behaviour, current/target) rather than refusing to show a
  /// bar for old items.
  startingCount Int?    @map("starting_count")

  /// Paid to the assigned External Worker (`outsourcedWorkerId` above) —
  /// an Employee is salaried and never has a per-item fee, confirmed
  /// directly (2026-10-08): "no fee of the internal employees." Computed
  /// automatically from `ServiceRate` when assigning (rate × the metric's
  /// required count, or a flat rate for a non-metric service — see
  /// `ServiceRate` below and `assignOrderItemWorker` in service.ts), but
  /// always a plain editable value afterward, never locked: "anyone
  /// putting the item there should be able to change the amount." Null
  /// when unassigned or when no rate is configured yet. Snapshotted —
  /// never retroactively recomputed by a later rate change.
  workerCost         Decimal? @map("worker_cost") @db.Decimal(14, 2)
  workerCostCurrency String   @default("USD") @map("worker_cost_currency") @db.Char(3)

  status OrderItemStatus @default(PENDING)

  /// When the current worker was assigned (owner request, 2026-11-03: the
  /// worker sees how long ago they were given the task). Reset on reassignment.
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Stamped when the item reaches DONE or CANCELLED (the two "earned" states,
  /// docs/REQUIREMENTS.md D5); cleared when a done item is sent to REFILL.
  /// Reports and Finance range on this instead of `updatedAt`, which moves on any edit.
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  /// Public stats pulled from the platform for `channelLink` (owner request,
  /// 2026-11-10; YouTube only so far, see src/lib/youtube/). The resolved
  /// channel (UC…) or video id, its kind ("CHANNEL" | "VIDEO") and title.
  statsSourceId   String?   @map("stats_source_id") @db.VarChar(64)
  statsSourceKind String?   @map("stats_source_kind") @db.VarChar(16)
  statsTitle      String?   @map("stats_title") @db.VarChar(300)
  /// Last successful fetch.
  statsFetchedAt  DateTime? @map("stats_fetched_at") @db.Timestamptz(6)
  /// Last attempt, successful or not; the scheduled refresh goes by this so a
  /// broken link is not retried on every run.
  statsCheckedAt  DateTime? @map("stats_checked_at") @db.Timestamptz(6)
  /// Why the last attempt failed, shown on the item. Cleared on success.
  statsError      String?   @map("stats_error") @db.VarChar(300)

  links         OrderItemLink[]
  statSnapshots OrderItemStatSnapshot[]
  updates       OrderItemUpdate[]

  @@index([orderId])
  @@index([statsCheckedAt])
  @@index([workerId, status])
  @@index([outsourcedWorkerId])
  @@index([assignedById])
  @@index([serviceId])
  @@index([categoryId])
  @@index([status])
  @@index([status, finishedAt])
  @@map("order_items")
}

/// An External Worker's price for one service — owner-directed, confirmed
/// directly (2026-10-08), worked example: "subscriber service by Zia
/// charges are 3.5pkr for 1 subscriber... the cost would be 500*3.5=1750."
/// Looked up by `(serviceId, outsourcedWorkerId)` when assigning an Order
/// Item, to compute `OrderItem.workerCost` automatically — see
/// `assignOrderItemWorker` in `src/lib/orders/service.ts`. Deliberately
/// NOT modelled for internal Employees: "rates would be set to workers
/// not employees" — an Employee is salaried, never priced per service.
model ServiceRate {
  id String @id @default(uuid()) @db.Uuid

  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  outsourcedWorkerId String           @map("outsourced_worker_id") @db.Uuid
  outsourcedWorker   OutsourcedWorker @relation(fields: [outsourcedWorkerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// For a metric service (views/subscribers/watch hours): price PER UNIT
  /// — multiplied by the item's required count (target minus starting —
  /// never charge for units the channel already had before any work
  /// started). For a non-metric service: a flat price per item,
  /// confirmed directly: "it'll be flat rate."
  rate     Decimal @db.Decimal(14, 2)
  currency String  @default("PKR") @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([serviceId, outsourcedWorkerId])
  @@map("service_rates")
}

/// A normalized URL attached to an Order Item (specification Sections 25, 27,
/// 133, 134) — a table, not a text field, because finding an order by a URL
/// substring or domain needs an index a notes blob cannot offer.
model OrderItemLink {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Exactly what the user typed, preserved verbatim. The server never
  /// fetches this URL.
  url String @db.Text

  /// Matching key: lower-cased scheme/host, default port and one trailing
  /// slash dropped. Path case and the query string are preserved — both are
  /// frequently meaningful. See docs/ORDERS.md §7.
  normalizedUrl String @map("normalized_url") @db.Text
  domain        String @db.VarChar(255)
  path          String @db.Text

  /// e.g. "Reference", "Delivery", "Repository" — free text, not a controlled list.
  label String? @db.VarChar(80)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("OrderItemLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderItemId])
  @@index([domain])
  // Trigram indexes for ILIKE '%q%' search (global search, docs/DATABASE.md). Declared here — with ops: raw("gin_trgm_ops") —
  // so `migrate dev` no longer proposes dropping them.
  @@index([normalizedUrl(ops: raw("gin_trgm_ops"))], type: Gin, map: "order_item_links_normalized_url_trgm_idx")
  @@map("order_item_links")
}

enum StatSnapshotTrigger {
  /// The first reading for a link: the baseline progress is measured from.
  INITIAL
  /// Someone pressed Refresh.
  MANUAL
  /// The periodic refresh (interval set in Settings).
  SCHEDULED
}

/// One reading of a link's public stats (owner request, 2026-11-10): "the
/// initial should be kept in the history as well so that we know how is the
/// progress going". Append-only. `sourceId` is the channel/video the reading
/// was for, so changing an item's link starts a fresh history instead of
/// mixing two channels. Counts are BigInt: a popular video passes 2^31 views.
model OrderItemStatSnapshot {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  sourceId String             @map("source_id") @db.VarChar(64)
  trigger  StatSnapshotTrigger

  subscribers BigInt?
  views       BigInt?
  likes       BigInt?
  comments    BigInt?

  /// Who pressed Refresh; null for automatic readings. Plain id + name, no
  /// relation: a reading must outlive the account that triggered it.
  triggeredById    String? @map("triggered_by_id") @db.Uuid
  triggeredByLabel String? @map("triggered_by_label") @db.VarChar(200)

  takenAt DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)

  @@index([orderItemId, takenAt])
  @@map("order_item_stat_snapshots")
}

/// A post in an item's updates thread (2026-11-11, owner request: "the updates
/// should be like a chat system"): the worker, or someone on the team, reports
/// progress with an optional new count, text and screenshots. Append-only.
/// The author is a plain id + name, no relation, so a post outlives its account.
model OrderItemUpdate {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  authorId    String? @map("author_id") @db.Uuid
  authorLabel String  @map("author_label") @db.VarChar(200)
  /// True when the author was the item's assigned worker when posting.
  fromWorker  Boolean @default(false) @map("from_worker")

  body String? @db.VarChar(2000)

  /// The count this update set the item to, and what it was before. Null when the update didn't change it.
  countValue    Int? @map("count_value")
  previousCount Int? @map("previous_count")

  /// Object paths in the private "item-updates" Storage bucket.
  imagePaths String[] @default([]) @map("image_paths")

  /// A worker asking the team for screenshots (2026-11-11, owner request), e.g.
  /// of a channel's analytics they can't open. Open until someone on the team
  /// answers it; the team sees a badge until then.
  isRequest       Boolean   @default(false) @map("is_request")
  /// "SCREENSHOTS", or "WITHDRAW" when the worker can't continue the task
  /// (2026-11-11, owner request): the team then moves what's left to someone else.
  requestType     String    @default("SCREENSHOTS") @map("request_type") @db.VarChar(20)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByLabel String?   @map("resolved_by_label") @db.VarChar(200)
  /// How it was resolved, e.g. "600 watch hours moved to Taimoor".
  resolutionNote  String?   @map("resolution_note") @db.VarChar(300)
  /// On an answer: the request it answered (plain id, same table).
  answersRequestId String? @map("answers_request_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderItemId, createdAt])
  @@index([isRequest, resolvedAt])
  @@map("order_item_updates")
}

/// Internal notes (specification Section 62) — distinct from `OrderActivity`.
model OrderNote {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  body String @db.Text

  authorId String @map("author_id") @db.Uuid
  author   User   @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId])
  @@map("order_notes")
}

/// The operational feed on an order (specification Section 64) — distinct
/// from `audit_logs` (the security/compliance record) and from `OrderNote`.
model OrderActivity {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("OrderActivityActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Denormalised snapshot so the feed stays readable after a rename, and so
  /// an outsourced-worker actor (no `User` row at all) can still be named.
  actorLabel String? @map("actor_label") @db.VarChar(160)

  /// Machine-readable, e.g. "order.status_changed".
  action  String @db.VarChar(80)
  /// Human-readable, e.g. "Ahmed changed the item status from In Progress to
  /// Internal Review."
  summary String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@map("order_activity")
}

/// Durable notification INTENT (specification Section 21 addition, justified
/// in docs/ARCHITECTURE.md §8). Written inside Process Order's transaction so
/// an unreachable email/WhatsApp provider never fails the order change itself.
/// No dispatcher drains this yet — that is Phase 8. Writing it now, rather
/// than skipping it until Phase 8, means Process Order's transaction shape
/// does not change when the dispatcher is added.
model NotificationOutbox {
  id String @id @default(uuid()) @db.Uuid

  /// What a future dispatcher will branch on. Was a free-text VarChar until
  /// Phase 8 formalized NotificationEvent as a real enum (messaging.prisma);
  /// the two values already written here ("order.processed",
  /// "order_item.stop_work_requested") were remapped by hand in the
  /// migration that added this column type — see docs/DEVELOPMENT.md.
  eventType NotificationEvent @map("event_type")
  /// Whatever the eventual dispatch needs — order id, recipient, rendered
  /// template variables, etc.
  payload   Json              @db.JsonB

  /// Intent-processing status ("has this row been drained yet"), distinct
  /// from MessageLog.status (per-channel delivery status, Section 71) — not
  /// worth conflating into one enum.
  status String    @default("PENDING") @db.VarChar(20)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
  error  String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("notification_outbox")
}
