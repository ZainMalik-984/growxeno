// ---------------------------------------------------------------------------
// CRM (Phase 2) — specification Sections 3, 49
//
// What is here:
//   - Customer: the end/job customer for an order.
//
// Removed entirely, post-Phase-10 (2026-09-27, owner-directed, confirmed
// directly: "Remove the Buyer category from order and from system its
// currently being used in orders"): Buyer, BuyerContact, BuyerPricing (and,
// in finance.prisma, BuyerPayment). The business's real order sources are
// Fiverr or direct/external clients (Customer) — the "recurring commercial
// client with its own contacts, credit limit and pricing overrides" concept
// this file originally modelled (specification Section 46) did not match
// that. Their tables, pages, permissions, nav entries and reports are gone,
// not merely hidden — a real migration dropped `buyers`, `buyer_contacts`,
// `buyer_pricing`, `buyer_payments`, and the `buyer_id` columns on `orders`
// and `customers`. See docs/REQUIREMENTS.md's "Buyer removed" note for the
// full record and docs/DATABASE.md for what used to be here.
//
// Money (docs/REQUIREMENTS.md D1, docs/ARCHITECTURE.md §2.4): every amount is
// paired with its own `currency` column, defaulting to "USD", because the
// business is paid in USD but pays workers a fixed PKR amount and books
// expenses in whichever currency they were actually paid in — there is no
// exchange-rate conversion anywhere in this system.
// ---------------------------------------------------------------------------

/// Deliberately simple classification for Customer. Reversible technical
/// choice, not specified verbatim — see docs/DATABASE.md. (Originally shared
/// with Buyer, which no longer exists — see the file header.)
enum PartyType {
  INDIVIDUAL
  COMPANY
}

/// The end/job customer (specification Section 3). Created only inline from
/// the order form's autocomplete (post-Phase-10, confirmed directly
/// 2026-09-27) — name required, email optional, nothing else asked for there.
model Customer {
  id   String    @id @default(uuid()) @db.Uuid
  name String    @db.VarChar(160)
  type PartyType @default(INDIVIDUAL)

  email String? @db.VarChar(320)
  phone String? @db.VarChar(32)
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  @@index([name])
  // Trigram indexes for ILIKE '%q%' search (global search, docs/DATABASE.md). Declared here — with ops: raw("gin_trgm_ops") —
  // so `migrate dev` no longer proposes dropping them.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_phone_trgm_idx")
  @@map("customers")
}
